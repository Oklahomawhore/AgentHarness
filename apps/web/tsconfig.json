{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "lib/types",
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  // Browser-assembled expectations and client units need the Client Context.
  // Native Web scenarios belong to the root Host program.
  "include": [
    "src",
    "tests/**/*.expected.e2e.ts",
    "tests/submission-echo.e2e.ts",
    "tests/assembled-boot.ts",
    "tests/**/*.client.spec.ts",
    "tests/**/*.client.spec.tsx"
  ],
  "references": [
    {
      "path": "../../packages/client/store"
    },
    {
      "path": "../../packages/client/web"
    },
    {
      "path": "../../packages/client/modules"
    }
  ]
}
