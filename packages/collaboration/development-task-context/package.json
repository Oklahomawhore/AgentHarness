    },
    "./reported": {
      "types": "./lib/types/reported.d.ts",
      "default": "./lib/types/reported.js"
    },
    "./configured": {
      "types": "./lib/types/configured.d.ts",
      "default": "./lib/types/configured.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
